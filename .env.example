# LLM Configuration
# Choose provider: "anthropic", "openai", or "qwen"
LLM_PROVIDER=xxx

# Qwen (DashScope) Configuration
DASHSCOPE_API_KEY=xxxx

# OpenAI Configuration (if using OpenAI)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (if using Anthropic)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Model Configuration
# Qwen models: qwen-plus, qwen-turbo, qwen-max, qwen-long
# OpenAI models: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic models: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
LLM_MODEL=xxxx
LLM_MAX_TOKENS=4096

# Optional: Custom API base URL
# For Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# For OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Browser Configuration
HEADLESS=false
BROWSER_TIMEOUT=30000

# Screenshot Configuration
SCREENSHOT_DIR=./screenshots
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_SUCCESS=false

# Report Configuration
REPORT_DIR=./reports
REPORT_FORMAT=html
