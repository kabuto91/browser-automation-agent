# LLM 配置
# 选择提供商: "anthropic", "openai", 或 "qwen"
LLM_PROVIDER=xxx

# 千问 (DashScope) 配置
DASHSCOPE_API_KEY=xxxx

# OpenAI 配置（如果使用 OpenAI）
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic 配置（如果使用 Anthropic）
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 模型配置
# 千问模型: qwen-plus, qwen-turbo, qwen-max, qwen-long
# OpenAI 模型: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Anthropic 模型: claude-sonnet-4-20250514, claude-3-5-sonnet-20241022
LLM_MODEL=xxxx
LLM_MAX_TOKENS=4096

# 可选: 自定义 API 基础 URL
# 千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI: https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 浏览器配置
HEADLESS=false
BROWSER_TIMEOUT=30000

# 截图配置
SCREENSHOT_DIR=./screenshots
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_SUCCESS=false

# 报告配置
REPORT_DIR=./reports
REPORT_FORMAT=html

# 安全配置 - 沙箱隔离
# URL 白名单: 逗号分隔的允许域名列表 (例如: example.com,test.example.com)
# URL_WHITELIST=example.com,test.example.com
URL_WHITELIST_ENABLED=false

# 阻止危险协议 (javascript:, data:, vbscript:, file:)
BLOCK_DANGEROUS_PROTOCOLS=true

# 网络隔离: 完全禁用网络访问
NETWORK_ISOLATION=false

# 代理配置: 通过代理路由所有流量
# PROXY_SERVER=http://proxy.example.com:8080
# PROXY_BYPASS_LIST=localhost,127.0.0.1,*.internal.example.com